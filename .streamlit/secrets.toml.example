# Copia este archivo como .streamlit/secrets.toml en local.
# En Streamlit Cloud, pega estos mismos valores en App > Settings > Secrets.

APP_PASSWORD = "Capacidad2026"

# Supabase
SUPABASE_URL = ""
SUPABASE_KEY = ""

# Usuarios opcionales. Si no se define USERS_JSON, se usa admin + APP_PASSWORD.
# USERS_JSON = '{"admin":{"password":"Capacidad2026","role":"admin","display_name":"Administrador"},"unidad1":{"password":"OtraClave","role":"usuario","display_name":"Unidad 1"}}'

# Mailgun opcional. Si no se configura, seguirá funcionando la descarga manual.
MAILGUN_API_KEY = ""
MAILGUN_DOMAIN = ""
MAILGUN_SENDER_EMAIL = ""
MAILGUN_RECIPIENT_EMAIL = ""
